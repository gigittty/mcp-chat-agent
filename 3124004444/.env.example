# 复制为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）
#
# ===== 规划器模式 =====
# mock = 离线规则式规划器（无需任何 API Key，默认）
# llm  = 调用 OpenAI 兼容接口
AGENT_MODE=mock

# ===== 大模型接入（AGENT_MODE=llm 时才读取）=====
# 任何 OpenAI 兼容服务都可以，例如：
#   DeepSeek : https://api.deepseek.com/v1        model=deepseek-chat
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4  model=glm-4-flash
#   阿里百炼 : https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 工具通道 =====
# auto    = 优先走 MCP stdio Server，失败自动降级为进程内直调（默认）
# mcp     = 强制走 MCP，失败即报错（答辩时用来证明真的在用 MCP）
# builtin = 完全不加载 mcp 包，只用进程内直调
MCP_CHANNEL=auto

# ===== 其他 =====
# 1 = 禁用联网（天气直接使用离线示例数据）
OFFLINE=0
# 单轮最大工具调用步数
MAX_STEPS=6
